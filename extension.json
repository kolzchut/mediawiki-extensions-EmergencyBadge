{
	"name": "EmergencyBadge",
	"namemsg": "emergencybadge-extensionname",
	"version": "0.1.1",
	"author": "Kol-Zchut",
	"description": "Shows the 'שאגת הארי' badge next to the site logo on pages with content area 'מצב חירום'. Temporary feature — remove by disabling this extension.",
	"descriptionmsg": "emergencybadge-extensiondesc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.35.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\EmergencyBadge\\": "src/"
	},
	"MessagesDirs": {
		"EmergencyBadge": [
			"i18n"
		]
	},
	"Hooks": {
		"BeforePageDisplay": "EmergencyBadgeHooks"
	},
	"HookHandlers": {
		"EmergencyBadgeHooks": {
			"class": "MediaWiki\\Extension\\EmergencyBadge\\Hooks"
		}
	},
	"ResourceModules": {
		"ext.emergencyBadge": {
			"scripts": [
				"resources/emergency-badge.js"
			],
			"styles": [
				"resources/emergency-badge.less"
			],
			"skipFunction": "resources/emergency-badge-skip.js"
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "WikiRights/EmergencyBadge"
	},
	"manifest_version": 2
}
